#!/usr/bin/env python3
"""Terminal access to the SheepIt prompt queue.

Reads and writes the same SQLite queue the gateway's dispatcher drives. There is
deliberately no `run` command: the dispatcher lives in the gateway, and a second
one racing it on the same queue would deliver every prompt twice.
"""

import argparse
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "gateway"))

from herdr_rpc import Herdr, HerdrError, call_herdr_rpc  # noqa: E402
from scheduler import config as sched_config  # noqa: E402
from scheduler import db, quota  # noqa: E402
from scheduler.dispatch import LIMIT_RE, wall_menu, wall_menu_keys  # noqa: E402

MARK = {
    "waiting": "·",
    "sent": "✓",
    "failed": "✗",
}


def _rel(when) -> str:
    if when is None:
        return "—"
    delta = (when - datetime.now(timezone.utc)).total_seconds()
    if delta <= 0:
        return "now"
    hours, minutes = divmod(int(delta // 60), 60)
    return f"{hours}h{minutes:02d}m" if hours else f"{minutes}m"


def cmd_quota(args) -> int:
    """Every agent's windows, since each spends its own subscription."""
    cfg = sched_config.load()
    agents = args.agent and [args.agent] or list(quota.SOURCES)
    failed = 0

    for i, agent in enumerate(agents):
        if len(agents) > 1:
            print(f"{'' if i == 0 else chr(10)}{agent}")
        try:
            current = quota.current(agent, ttl=0.0)
        except quota.QuotaError as e:
            print(f"  no reading: {e}", file=sys.stderr)
            failed += 1
            continue

        if current.source == "observed":
            print(f"(as {agent} last saw it, {current.fetched_at:%Y-%m-%d %H:%M} UTC)")
        elif current.stale:
            print(f"(cached at {current.fetched_at:%Y-%m-%d %H:%M} UTC — endpoint unreachable)")

        width = max((len(b.name) for b in current.buckets), default=10)
        for b in current.buckets:
            filled = min(24, int(b.utilization / 100 * 24))
            bar = "█" * filled + "░" * (24 - filled)
            flag = " LOCKED" if b.locked_reason else ""
            over = " ←" if b.is_blocking(cfg.threshold) else ""
            print(f"{b.name:<{width}}  {bar} {b.utilization:5.1f}%  "
                  f"resets in {_rel(b.resets_at):>7}{flag}{over}")

        if current.blockers(cfg.threshold):
            print(f"blocked at {cfg.threshold:.0f}% — "
                  f"next window {_rel(current.resume_at(cfg.threshold))}")
        else:
            print(f"clear to run (threshold {cfg.threshold:.0f}%)")

    return 1 if failed == len(agents) else 0


def _chats() -> dict:
    """pane_id -> a name worth printing, for whatever Herdr has open."""
    out = {}
    for pane in call_herdr_rpc("pane.list").get("result", {}).get("panes", []):
        out[pane.get("pane_id")] = pane.get("cwd", "").rsplit("/", 1)[-1]
    return out


def cmd_chats(args) -> int:
    """The pane ids to queue against, which is the only id this tool needs."""
    agents = call_herdr_rpc("agent.list").get("result", {}).get("agents", [])
    if not agents:
        print("no chats open")
        return 0
    for a in agents:
        print(f"{a.get('pane_id'):<8} {a.get('agent_status', '?'):<8} {a.get('cwd', '')}")
    return 0


def cmd_wall(args) -> int:
    """What the dispatcher would do about the limit, without waiting for one.

    The wall is the one part of the queue that cannot be rehearsed by using the
    app: it only happens when a subscription runs out, at whatever hour that
    lands on, and if it gets it wrong the evidence is a chat that sat still all
    night. So this asks the same questions `hit_the_wall` asks, against a real
    pane, and prints the answers instead of acting on them.

    To put the menu on screen on purpose, type `/rate-limit-options` into the
    chat: it is the same menu Claude Code opens for itself, so answering it here
    is the real thing and not a fixture. `--send` then presses it, which is the
    last step this cannot prove on its own — that the keys land.
    """
    if args.screen:
        text, where = Path(args.screen).read_text(), args.screen
    else:
        try:
            text, where = Herdr().pane_read(args.pane, lines=args.lines), args.pane
        except HerdrError as e:
            print(f"error: cannot read {args.pane}: {e}", file=sys.stderr)
            return 1

    status, kind = "?", None
    if args.pane:
        # The same two questions the dispatcher asks, through the same client:
        # whose window this pane spends, and whether it is mid-turn.
        herdr = Herdr()
        status, kind = herdr.status(args.pane), herdr.agent_kind(args.pane)
    print(f"chat      {where}  status {status}  agent {kind or 'shell'}")

    banner = LIMIT_RE.search(text)
    print(f"banner    matched {banner.group(0)!r}" if banner
          else "banner    no match — nothing would wake the wall up")

    keys = wall_menu_keys(text)
    options, selected, wanted = wall_menu(text)
    for i, option in enumerate(options):
        mark = "  ← would press" if i == wanted else ""
        print(f"menu      {'❯' if i == selected else ' '} {i + 1}. {option}{mark}")
    if not options:
        print("menu      none on screen")
    elif wanted is None:
        print("menu      nothing here says to wait — left for a person")
    elif selected is None:
        print("menu      no cursor on any option — left for a person")
    print(f"keys      {keys if keys else 'esc (nothing to answer)'}")

    spent = None
    try:
        current = quota.current(kind or "", ttl=0.0)
        spent = current.spent()
        print(f"usage     {', '.join(f'{b.name} {b.utilization:.0f}%' for b in current.buckets)}"
              f"{'  — out' if spent else '  — open'}")
    except quota.QuotaError as e:
        print(f"usage     no reading ({e})")

    if status == "working":
        verdict = "nothing: a pane mid-turn is never interrupted"
    elif not banner:
        verdict = "nothing: no limit text on screen"
    elif keys:
        verdict = f"answers the menu with {keys}, queues the resume, holds until the reset"
    elif spent is None or spent:
        verdict = "esc to drop the halted turn, queues the resume, holds until the reset"
    else:
        verdict = "nothing: the banner is there but usage says the window is open"
    print(f"verdict   {verdict}")

    if args.send:
        if not args.pane:
            print("error: --send needs --pane, not --screen", file=sys.stderr)
            return 1
        Herdr().agent_send_keys(args.pane, keys or ["esc"])
        print(f"sent      {keys or ['esc']} to {args.pane} — watch the pane")
    return 0


def cmd_add(args) -> int:
    conn = db.connect()
    pane = call_herdr_rpc("pane.get", {"pane_id": args.pane}).get("result", {}).get("pane")
    if not pane:
        print(f"error: no chat {args.pane} (try `sheepit-queue chats`)", file=sys.stderr)
        return 1

    # No agent in the pane means no queue: it is a shell, and a shell takes the
    # text typed at it. Same rule the gateway's own send path follows.
    status = pane.get("agent_status")
    if not status or status == "unknown":
        call_herdr_rpc("pane.send_text", {"pane_id": args.pane, "text": args.prompt})
        res = call_herdr_rpc("pane.send_keys", {"pane_id": args.pane, "keys": ["enter"]})
        if "error" in res:
            print(f"error: {res['error'].get('message')}", file=sys.stderr)
            return 1
        print(f"typed into {args.pane} (no agent there to queue for)")
        return 0

    prompt_id = db.add(
        conn,
        pane_id=args.pane,
        prompt=args.prompt,
        workspace_id=pane.get("workspace_id"),
        session_uuid=(pane.get("agent_session") or {}).get("value"),
        cwd=pane.get("cwd"),
    )
    print(f"queued #{prompt_id} for {args.pane}")
    return 0


def cmd_list(args) -> int:
    conn = db.connect()
    prompts = db.list_prompts(conn, args.pane, args.state)
    if not prompts:
        print("nothing queued")
        return 0
    names = _chats()
    for p in prompts:
        head = p.prompt.splitlines()[0][:52]
        where = names.get(p.pane_id) or p.pane_id
        print(f"{MARK.get(p.state, ' ')} #{p.id:<4} {p.state:<8} {head}  [{where}]")
        if p.last_error:
            print(f"          └─ {p.last_error}")
    return 0


def cmd_show(args) -> int:
    conn = db.connect()
    queued = db.get(conn, args.id)
    if queued is None:
        print(f"error: no prompt #{args.id}", file=sys.stderr)
        return 1
    for key, value in vars(queued).items():
        if value not in (None, ""):
            print(f"{key:<16} {value}")
    return 0


def cmd_rm(args) -> int:
    conn = db.connect()
    db.delete(conn, args.id)
    print(f"removed #{args.id}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="sheepit-queue", description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)

    p_quota = sub.add_parser("quota", help="show usage windows")
    p_quota.add_argument("agent", nargs="?", choices=sorted(quota.SOURCES),
                         help="just this agent's windows")
    p_quota.set_defaults(func=cmd_quota)
    sub.add_parser("chats", help="list chats you can queue against").set_defaults(func=cmd_chats)

    wall = sub.add_parser("wall", help="what the wall would do about this chat, without doing it")
    source = wall.add_mutually_exclusive_group(required=True)
    source.add_argument("--pane", help="read a live chat, e.g. wM:p1")
    source.add_argument("--screen", help="read a captured screen from a file instead")
    wall.add_argument("--lines", type=int, default=80, help="how much of the pane to read")
    wall.add_argument("--send", action="store_true",
                      help="actually press it, so you can watch the pane answer")
    wall.set_defaults(func=cmd_wall)

    add = sub.add_parser("add", help="queue a prompt for a chat")
    add.add_argument("prompt")
    add.add_argument("--pane", required=True, help="pane id of the chat, e.g. wM:p1")
    add.set_defaults(func=cmd_add)

    ls = sub.add_parser("list", help="list queued prompts")
    ls.add_argument("--pane", help="only this chat")
    ls.add_argument("--state", choices=db.STATES)
    ls.set_defaults(func=cmd_list)

    show = sub.add_parser("show", help="show one queued prompt")
    show.add_argument("id", type=int)
    show.set_defaults(func=cmd_show)

    rm = sub.add_parser("rm", help="delete a queued prompt")
    rm.add_argument("id", type=int)
    rm.set_defaults(func=cmd_rm)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
