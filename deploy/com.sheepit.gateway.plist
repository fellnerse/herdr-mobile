<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sheepit.gateway</string>

    <!-- System python3 is in the macOS firewall allowlist; Homebrew python is not. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>SHEEPIT_DIR/gateway/server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>SHEEPIT_DIR</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOST</key>
        <string>127.0.0.1</string>
        <key>SHEEPIT_PORT</key>
        <string>3009</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>SHEEPIT_DIR/sheepit.log</string>
    <key>StandardErrorPath</key>
    <string>SHEEPIT_DIR/sheepit.log</string>
</dict>
</plist>
