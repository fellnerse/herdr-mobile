<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sheepit.menubar</string>

    <!-- Launches the menu bar app at login. Scripting System Events to add a
         Login Item needs Automation permission this cannot prompt for, and
         `open` re-uses the running instance rather than starting a second. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>/Applications/SheepIt.app</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
