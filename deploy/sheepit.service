[Unit]
Description=SheepIt gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/herdr-mobile
ExecStart=/usr/bin/python3 /root/projects/herdr-mobile/gateway/server.py
Restart=always
Environment=SHEEPIT_PORT=3009
Environment=HOST=127.0.0.1
# Where Herdr itself listens.
Environment=HERDR_SOCKET=/root/.config/herdr/herdr.sock

[Install]
WantedBy=multi-user.target
